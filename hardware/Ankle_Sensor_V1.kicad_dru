# Pair-only clearance follows the selected 0.17/0.13 mm USB geometry.
# Other nets retain 0.15 mm. JLC7628 4L1.0mm: see docs/usb_stackup_final_A1.md.
(version 1)
(rule "USB_DP_DN_controlled_geometry"
 (condition "(A.NetName == 'USB_DP' && B.NetName == 'USB_DN') || (A.NetName == 'USB_DN' && B.NetName == 'USB_DP')")
 (constraint clearance (min 0.125mm))
 (constraint diff_pair_gap (min 0.125mm) (opt 0.13mm)))
